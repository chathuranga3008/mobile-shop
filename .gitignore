# ==================================================
# Mobile Shop Management System - root .gitignore
# Covers Angular frontend and Spring Boot backend
# ==================================================

# ------------------------------
# Angular / Node.js (frontend)
# ------------------------------
frontend/dist/
frontend/tmp/
frontend/out-tsc/
frontend/bazel-out/
frontend/node_modules/
frontend/npm-debug.log
frontend/yarn-error.log
frontend/.angular/cache/
frontend/.sass-cache/
frontend/coverage/
frontend/.history/
frontend/__screenshots__/
frontend/typings/

# ------------------------------
# Java / Maven (backend)
# ------------------------------
backend/target/
backend/build/
backend/.mvn/wrapper/maven-wrapper.jar
backend/HELP.md

# Keep generated output out of source trees if any tools create it there
!backend/src/main/**/target/
!backend/src/test/**/target/
!backend/src/main/**/build/
!backend/src/test/**/build/

# ------------------------------
# Environment files / secrets
# ------------------------------
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# ------------------------------
# IDEs and editors
# ------------------------------
.idea/
**/.idea/
*.iws
*.iml
*.ipr
.project
.classpath
.factorypath
.settings/
**/.settings/
.springBeans
.sts4-cache
.apt_generated
.c9/
*.launch
*.sublime-workspace
.nb-gradle/
nbproject/private/
nbbuild/
nbdist/

# ------------------------------
# Visual Studio Code
# Ignore workspace-specific files, but allow shared project settings
# ------------------------------
.vscode/*
**/.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
!**/.vscode/mcp.json

# ------------------------------
# Miscellaneous build / test output
# ------------------------------
/dist/
/tmp/
/out-tsc/
/bazel-out/
/coverage/
/typings/
/connect.lock
/libpeerconnection.log
testem.log
__screenshots__/

# ------------------------------
# Operating system files
# ------------------------------
.DS_Store
Thumbs.db

.fake